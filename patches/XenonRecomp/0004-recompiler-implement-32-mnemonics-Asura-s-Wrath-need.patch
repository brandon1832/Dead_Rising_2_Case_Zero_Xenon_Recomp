+// vctuxs: float -> u32 with saturation (NaN and negatives -> 0, >= 2^32 -> 0xFFFFFFFF).
+// cvttps_epi32 only reaches INT_MAX, so lanes >= 2^31 are converted with the high
+// bit split off (subtract 2^31, convert, add it back as an integer).
+inline simde__m128i simde_mm_vctuxs(simde__m128 src1)
+{
+    simde__m128 zero = simde_mm_setzero_ps();
+    // max_ps returns the second operand when either input is NaN, so this also maps NaN to 0
+    simde__m128 clamped = simde_mm_max_ps(src1, zero);
+    simde__m128 two31 = simde_mm_set1_ps(2147483648.0f);
+    simde__m128i lo = simde_mm_cvttps_epi32(clamped);
+    simde__m128i hi = simde_mm_add_epi32(simde_mm_cvttps_epi32(simde_mm_sub_ps(clamped, two31)), simde_mm_set1_epi32(INT_MIN));
+    simde__m128i result = simde_mm_blendv_epi8(lo, hi, simde_mm_castps_si128(simde_mm_cmpge_ps(clamped, two31)));
+    // saturate lanes at or above 2^32 (cmpge produces all-ones = 0xFFFFFFFF)
+    return simde_mm_or_si128(result, simde_mm_castps_si128(simde_mm_cmpge_ps(clamped, simde_mm_set1_ps(4294967296.0f))));
+}
